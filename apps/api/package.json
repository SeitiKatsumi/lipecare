{
  "name": "@lipecare/api",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/modules/auth/auth.schemas.spec.js dist/modules/ai-chat/ai-chat.service.spec.js dist/modules/clinical/clinical.service.spec.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "openai": "^7.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
